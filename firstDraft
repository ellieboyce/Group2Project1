# Group 2 Project 1

# Reading the Shakespeare text file

setwd("~/Group2Project1")
a <- scan("shakespeare.txt",what="character",skip=83,nlines=196043-83,fileEncoding="UTF-8")


# build a record of stage directions
open_bracket <- grep("\\[", a) 
stage_dir <- c()
for (i in open_bracket) {
  stage_dir_index <- grep("\\]", a[(i+1):(i+100)])
  if (length(stage_dir_index) > 0) {
    close_bracket <- i + stage_dir_index[1] 
    stage_dir <- c(stage_dir, i:close_bracket)
  }
}
a.clean <- a[-stage_dir]

### Remove Numerals and Uppercase (Except I and A)
remove_index <- which(a == toupper(a) & a != "I" & a != "A")
a.clean <- a.clean[-remove_index]

### Removing _ and - and —
a.clean <- gsub("_", "", a.clean)
a.clean <- gsub("-", " ", a.clean)
a.clean <- gsub("—", " ", a.clean)

### Splitting Puncutation
split_punct <- function(punct) {
  y <- gsub(punct, paste(" ",punct, sep = ""), a.clean)
  y <- strsplit(y,split = " ")
  a.clean <- do.call(c,y)
}

# For loop to split up punctuation
punctuation <- list(",","\\.",";","!",":","\\?")
 for (x in punctuation) {
  a.clean <- split_punct(x)
 }

### Make everything lower case
a.clean <- tolower(a.clean)


################## (5) Find 1000 most common words ############################

## Deleted duplicate words
unique_word_list <- unique(a.clean)

## Match each work in word_list3 to the unique word vector
index_list <- match(a.clean, unique_word_list)

## Tabulate to find how common each word is
tab <- tabulate(index_list)
ranked_tab <- rank(tab, ties.method ='min')

## The 4 most common 'words' in order are: "," "." "the" "and"
common_words_index <- order(ranked_tab, decreasing=TRUE)[1:1000]
common_words <- unique_word_list[common_words_index]
common_words