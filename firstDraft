##7 Creating the key
next.word <- function(key, M, M1, w = rep(1, ncol(M) - 1)) {
  mlag <- ncol(M) - 1
  key <- tail(key, mlag)
  if (length(key) < mlag) key <- c(rep(NA, mlag - length(key)), key)
  probs <- rep(0, max(M1, na.rm = TRUE))
  
  for (mc in seq_len(mlag)) {
    ## Match key to columns mc:mlag of M
    key_sub <- key[(mlag - mc + 1):mlag]
    M_sub <- M[, mc:mlag, drop = FALSE]
    ## Inserting ii as described
    ii <- colSums(!(t(M_sub) == key_sub))
    ## Find rows where ii == 0 and is.finite(ii)
    match_rows <- which(ii == 0 & is.finite(ii))
    next_tokens <- M[match_rows, mlag + 1]
    tab <- tabulate(next_tokens, nbins = max(M1, na.rm = TRUE))
    probs[1:length(tab)] <- probs[1:length(tab)] + w[mc] * tab
  }
  if (sum(probs) == 0) {
    tab <- tabulate(M1, nbins = max(M1, na.rm = TRUE))
    probs[1:length(tab)] <- tab
  }
  next_token <- sample(seq_along(probs), size = 1, prob = probs)
  return(next_token)
}

