# Reading the Shakespeare text file
#setwd("~/Group2Project1")
a <- scan("shakespeare.txt",what="character",skip=83,nlines=196043-83,fileEncoding="UTF-8")

# ----------------------------------

# We began by cleaning the Shakespeare text file to create a simple vector of words
# We needed to remove stage directions, punctuation, headings, and numbers

# Building a record of stage directions by locating words that contain brackets
open_bracket <- grep("\\[", a) # locating open bracket positions
stage_dir <- c()
for (i in open_bracket) {
  stage_dir_index <- grep("\\]", a[(i+1):(i+100)])
  if (length(stage_dir_index) > 0) {  # loop through to find corresponding close bracket
    close_bracket <- i + stage_dir_index[1]
    stage_dir <- c(stage_dir, i:close_bracket) # adding to our record
  }
}
a.clean <- a[-stage_dir] # removing these stage directions from the file

# Removing names and numbers by deleting uppercase words (Except I and A)
remove_index <- which(a == toupper(a) & a != "I" & a != "A")
a.clean <- a.clean[-remove_index]

# Removing dashes and underscores
a.clean <- gsub("_", "", a.clean)
a.clean <- gsub("-", " ", a.clean)
a.clean <- gsub("—", " ", a.clean)

# Creating a function that splits the punctuation from their words
split_punct <- function(punct) {
  y <- gsub(punct, paste(" ",punct, sep = ""), a.clean)
  y <- strsplit(y,split = " ")
  a.clean <- do.call(c,y)
}

# Looping through the text to split up punctuation using our function
punctuation <- c(",", "\\.", ";", "!", ":", "\\?")
for (x in punctuation) {
  a.clean <- split_punct(x)
}

a.clean <- tolower(a.clean) # making everything lower case

# Now that we have a clean set of strings to work with, we want to find the most common words in the text and then store this in a vector called 'b'.

unique_words <- unique(a.clean) # deleting duplicate words
index_vector <- match(a.clean, unique_words) # matching each word to the unique words vector
freq <- tabulate(index_vector) # counting how frequently each word occurs
rank_freq <- rank(freq, ties.method='min') # rank of most common words

b_index <- order(rank_freq, decreasing=TRUE)[1:1000] # ordering words from the most common
b <- unique_words[b_index] # vector b of common words

# Using this vector of common words, we constructed a matrix (M) of common word token sequences

mlag <- 4 # maximum lag considered
token <- match(a.clean, b) # tokens of common words
n <- length(token)
M <- matrix(NA, nrow = n - mlag, ncol = mlag + 1) # starting with an empty (n-mlag)x(mlag+1) matrix
M1 <- token

# Adding token vectors to the matrix
for(i in 1:(mlag+1)) {
  M[,i] <- token[i:(n-mlag+i-1)]
}

# ---------------------------------------------------------------------

# Creating a function which predicts the next word of a given sequence

next_word <- function(key, M, M1, w = rep(1, ncol(M) - 1)) {
  # Initialising the variables we'll be using in our function
  sentence <- c()
  match2 <- c()
  next_word_token <- 1
  mc <- 1
  
  sentence[length(sentence)+1] <- b[key[mlag]] # setting the components of our sentence for the model

  while (b[next_word_token] != ".") {
    for (mc in 1:mlag) {
      if (length(match2) > 0) {
        break # telling the model to stop the sentence after it encounters a full stop
      }
      ii <- colSums(!(t(M[,mc:mlag,drop=FALSE])==key[mc:mlag])) # setting the model to match the line in the matrix that fits the key 
      # as well as setting the length of sequence of words the model should use for prediction
      match <- which(ii == 0 & is.finite(ii)) # this and next 4 lines are setting the model to 
      # only select as a match the words in matrix rather than empty cell 'NA' and the conditions for this
      if (length(match) > 0) {
        for (s in 1:length(match)) {
          if (is.na(M[match[s],mlag+1]) == FALSE) {
            match2[length(match2)+1] <- match[s]
          }
        }
      }
    }
    
    next_word_index <- match2[sample(1:length(match2),1)]  # pick a random matching row
    next_word_token <- as.numeric(M[next_word_index, mlag+1])
    
    #create our sentence
    sentence[length(sentence)+1] <- b[next_word_token]
    
    #update our key to come from matrix of common words 'm'
    for (m in 1:(mlag-1)) {
      key[m] <- key[m+1]
    }
    key[mlag] <- next_word_token
    
    #reset object
    match2 <- NULL
    
    
  }
  sentence[1] <- gsub("(^[[:alpha:]])", "\\U\\1", sentence[1], perl=TRUE) # capitalising the first word of the sentence
  gsub(" (\\.)", "\\1", paste(sentence, collapse = " ")) # removing space between last word and full stop and printing our sentence

}

