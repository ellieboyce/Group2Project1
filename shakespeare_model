# Simulating our sentences

punctuation = c(",",".","?","!",";",":")
start_token <- sample(which(!(b %in% punctuation)),1)

key <- rep(NA, mlag - 1) # initialising the key
key <- c(key, start_token)

sentence <- next_word(key,M) # running our function to create a sentence
