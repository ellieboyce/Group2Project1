### Applying our functions to create plots

n <- 10000     # population size
hmax <- 5      # maximum household size

# household vector, which identifies which household a person belongs to
h <- sample(rep(1:n, sample(1:hmax, n, replace = TRUE))[1:n])

# assign each person to a sociability value between 0 and 1
beta <- runif(n)

# building the social network model
alink <- get.net(beta, h, nc = 15)

par(mfcol = c(2,2), mar = c(4,4,1,1)) ## set plot window up for multiple plots


## Consider the following four scenarios: 
## First is our original model with household and regular
## contacts. Second is a model with only random mixing, 
## however alpha_r is increased to maintain a similar amount
## of total interactions as scenario 1.
## Scenario 3 and 4 are repeats of the first two however this
## time we make our beta vector constant by making every element
## equal to the mean of the previous beta.


# Scenario 1 : Full model
scenario1 <- nseir(beta, h, alink, alpha = c(.1,.01,.01))
make_graph(scenario1) ## Our model that considers social factors 
title(main = "Social factors")


# Scenario 2 : Random mixing only
#      alpha_h = alpha_c = 0, alpha_r = 0.4
scenario2 <- nseir(beta, h, alink, alpha = c(0,0,0.4))
make_graph(scenario2) ## Consider the model with no social factors
title(main = "Random mixing only")
legend("right",
       legend = c("Susceptible (S)", "Exposed (E)", "Infectious (I)", "Recovered (R)"),
       col = c("slateblue", "turquoise3", "red2", "dodgerblue"),
       lwd = 2, bty = "n", cex = 0.9)


# Scenario 3 : Constant beta with household and network structure
beta_c <- rep(mean(beta), n)           # constant beta
alink_c <- get.net(beta_c, h, nc = 15) # social network model with constant beta
scenario3 <- nseir(beta_c, h, alink_c, alpha = c(.1,.01,.01))
make_graph(scenario3) ## Constant beta, social factors
title(main = "Social factors, constant beta")


# Scenario 4 : Constant beta and random mixing only
scenario4 <- nseir(beta_c, h, alink_c, alpha = c(0,0,0.04))
make_graph(scenario4) ## Constant beta, no social factors
title(main = "Random mixing only, constant beta")



