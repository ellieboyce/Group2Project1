## STEP 2: Building the contact network model

#  beta = vector of sociability
#  h = household membership vector
#  nc = average number of contacts per person

get.net <- function(beta, h, nc = 15) {
  bmu <- mean(beta) # mean sociability parameter
  alink <- vector("list", n) # creating an empty vector to star
  constant <- nc / (bmu^2 * (n - 1))
  
  for (i in 1:(n - 1)) {
    for (j in (i + 1):n) {
      if (h[i] != h[j]) {
        random_probability = beta[i]*beta[j]*constant
        if (runif(1) < random_probability) {
          alink[[i]] <- c(alink[[i]], j)
          alink[[j]] <- c(alink[[j]], i)
        }
      }
    }
  }
  
  return(alink)
}

# each person has a sociability value beta_i (higher => more connections)
# people in the same household cannot be linked in the network
# probability of a link
# (nc*beta_i*beta_j)/(beta^2*(n-1))
# links are undirected => if i-j exists, so does j-i
# alink[[i]] gives all indices of i's contacts

