### FUNCTION: get.net

#  Creating a social contact network between people, based on their
#  sociability and their household.

#   beta : vector of sociability
#   h : household ID vector
#   nc : average number of contacts per person

#  returns a list, where the ith element is a vector of the indices of the
#  regular (non-household) contacts of person i

#-------------------------------------------------------------------------------

get.net <- function(beta, h, nc = 15) {
  bmu <- mean(beta)                   # mean sociability parameter
  alink <- vector("list", n)          # initialise a vector to store links
  
  for (i in 1:n) {
    prob <- (nc*beta[i]*beta)/((bmu^2)*(n-1)) # the probability of a link between i and j
    u <- runif(n)                     # random uniform deviates
    
    b <- which((u < prob) & (h != h[i])) ## Avoid some household contacts
    b <- b[b > i]
    alink[[i]] <- c(alink[[i]], b) # Assign person i's regular contacts
    
    for(x in alink[[i]]) {    # Recording all contacts twice
      if (x > i){
        alink[[x]] <- c(alink[[x]], i)
      }
    }
  }
  return(alink)
}




