#### Plot the dynamics of our epidemics ####

make_graph <- function(epi) {
  plot(epi$t, epi$S, type = "n", ylim=c(0,max(epi$S)), xlab="Days", ylab="People")
  lines(epi$S, col= "purple")
  lines(epi$E, col= "deeppink")
  lines(epi$I, col= "black")
  lines(epi$R, col= "dodgerblue")
}


