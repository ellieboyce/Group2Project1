### FUNCTION: make_graph

#  Plot the dynamics of our epidemics over time
#  epi : list returned by nseir()

make_graph <- function(epi, normalize = FALSE) {

  plot(epi$t, epi$S, type = "n",
       ylim = c(0, max(epi$S)),
       xlab = "Days since start of simulation",
       ylab = "Number of people",
       cex.lab = 1.2,
       cex.axis = 1.1,
       cex.main = 1.2)
  
  grid(col = "lightgray", lty = "dotted")
  
  lines(epi$t, epi$S, col = "slateblue", lwd = 2)
  lines(epi$t, epi$E, col = "turquoise3", lwd = 2)
  lines(epi$t, epi$I, col = "red2", lwd = 2)
  lines(epi$t, epi$R, col = "dodgerblue", lwd = 2)
  
}



