## STEP 3:

# each day E -> I with probability gamma
# I -> R with probability delta
# S -> E based on household infections (a_h), contact network infections (a_c) and random mixing (a_r)
# delivers a function that returns counts of S,E,I,R over time

nseir <- function(beta, h, alink,
                  alpha = c(.1, .01, .01), 
                  delta = .2, # daily probability of I moving to R
                  gamma = .4, # daily probability of E moving to I
                  nc = 15, # average number of contacts per person
                  nt = 100, # number of days
                  pinf = .005) {
  
  bmu <- mean(beta) # mean sociability parameter

  # States: 0 = S, 1 = E, 2 = I, 3 = R
  # starting everyone in state S, except pinf*n people in I
  x <- rep(0, n)
  first_inf <- sample(1:n, round(pinf * n))
  x[first_inf] <- 2 # pinf*n people in starting in state I
  
  S <- E <- I <- R <- rep(0, nt) # storage for population in each state
  
  # initialising the number of people in each state on day 1
  S[1] <- sum(x == 0)
  E[1] <- sum(x == 1)
  I[1] <- sum(x == 2)
  R[1] <- sum(x == 3)
  
  alpha_h <- alpha[1] # daily probability of person in state I infecting household member in state S
  alpha_c <- alpha[2] # daily probability of person in state I infecting a person in their contact network
  alpha_r <- alpha[3] # daily probability of person in state I infecting by random mixing
  
  constant <- alpha_r * nc / (bmu^2 * (n - 1))
  
  # looping over the days
  for (t in 2:nt) {
    state <- x
    infected <- which(x == 2)
    exposed <- which(x == 1)

    # transitioning from I to R
    if (length(infected) > 0) {
      recovered <- runif(length(infected)) < delta
      state[infected[recovered]] <- 3
    }
    
    # transitioning from E to I
    if (length(exposed) > 0) {
      inf_next <- runif(length(exposed)) < gamma
      state[exposed[inf_next]] <- 2
    }
    
    infected <- which(x == 2)
    susceptible <- which(x == 0)
    
    if (length(inf) > 0 && length(susceptible) > 0) {

      inf_risk <- rep(FALSE, n)

      for (i in inf) {

        # household transmission
        household <- tabulate(h[i], nbins = max(h))
        if (length(household) > 0) {
          infections <- runif(length(household)) < alpha_h
          inf_risk[household[infections]] <- TRUE
        }

        # regular contacts
        contacts <- alink[[i]]
        if (length(contacts) > 0) {
          S_contacts <- contacts[state[contacts] == 0]
          if (length(S_contacts) > 0) {
            infections <- runif(length(S_contacts)) < alpha_c
            inf_risk[S_contacts[infections]] <- TRUE
          }
        }

        # random mixing
        if (length(sus) > 0) {
          random_prob <- constant * beta[i] * beta[sus]
          infections <- runif(length(sus)) < random_prob
          inf_risk[sus[infections]] <- TRUE
        }
      }
      state[inf_risk] <- 1
    }
    
    x <- state
    
    S[t] <- sum(x == 0)
    E[t] <- sum(x == 1)
    I[t] <- sum(x == 2)
    R[t] <- sum(x == 3)
  }
  
  list(S=S, E=E, I=I, R=R, t = 1:nt)
}


#### Plot the dynamics of our epidemics ####

par(mfcol=c(2,2),mar=c(4,4,1,1)) ## set plot window up for multiple plots

make_graph <- function(epi) {
  plot(epi$S,ylim=c(0,max(epi$S)),xlab="day",ylab="N") ## S black
  points(epi$E,col=4);points(epi$I,col=2) ## E (blue) and I (red)
  
}

