### FUNCTION: get.net

#  Creating a social contact network between people, based on their
#  sociability and their household.

#   beta : vector of sociability
#   h : household ID vector
#   nc : average number of contacts per person

#  returns a list, where the ith element is a vector of the indices of the
#  regular (non-household) contacts of person i

get.net <- function(beta, h, nc = 15) {
  bmu <- mean(beta)                   # mean sociability parameter
  alink <- vector("list", n)          # creating an empty vector to store links
  
  # given the probability of a link between i and j
  # nc * beta[i] * beta[j] / (bmu^2 * (n - 1))

  constant <- nc / (bmu^2 * (n - 1))  # the constant term from probability
  
  # loop through each pair of people once
  for (i in 1:(n - 1)) {
    for (j in (i + 1):n) {

      # skip if i and j are in the same household
      if (h[i] != h[j]) {

        # calulate the probability of a link
        random_probability = beta[i]*beta[j]*constant

        # draw a random number to decide if a link exists
        if (runif(1) < random_probability) {

          # record the link both ways
          alink[[i]] <- c(alink[[i]], j)
          alink[[j]] <- c(alink[[j]], i)
        }
      }
    }
  }
  
  return(alink)
}


