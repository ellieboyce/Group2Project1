### FUNCTION: nseir

#  Creating a SEIR epidemic simulation

#  Each day, people may change states:
#        E -> I : exposed becomes infectious
#        I -> R : infectious recovers
#        S -> E : become exposed after contact with an infectious person

#  Transmission can occur throughL
#        household contact
#        social network contact
#        random mixing

#  beta : vector of sociability
#  h : household ID vector
#  alink : contacts returned by get.net()
#  alpha : infection probabilities for household, contact, random mixing
#  delta : probability of infected recovering
#  gamma : probability of exposed becoming infected
#  nc : average number of contacts
#  nt : number of simulated days
#  pinf : initial proportion of population starting as infected

# returns a list with elements S, E, I, R and t giving the total population in each state each day

#-------------------------------------------------------------------------------

nseir <- function(beta, h, alink, alpha = c(.1, .01, .01), 
                  delta = .2, # daily probability of I moving to R
                  gamma = .4, # daily probability of E moving to I
                  nc = 15, # average number of contacts per person
                  nt = 100, # number of days
                  pinf = .005) {
  
  bmu <- mean(beta) # mean sociability parameter
  
  # States: 0 = S, 1 = E, 2 = I, 3 = R
  x <- rep(0, n)                            # starting everyone in state S
  first_inf <- sample(1:n, round(pinf * n)) # randomly choose initial infected people
  x[first_inf] <- 2                         # pinf*n people in starting in state I
  
  # storage for population in each state
  S <- E <- I <- R <- rep(0, nt)
  
  # initialising the number of people in each state on day 1
  S[1] <- sum(x == 0)
  E[1] <- sum(x == 1)
  I[1] <- sum(x == 2)
  R[1] <- sum(x == 3)
  
  # daily transmission probabilities
  alpha_h <- alpha[1] # household infection rate
  alpha_c <- alpha[2] # social network infection rate
  alpha_r <- alpha[3] # random mixing infection rate
  
  # constant used in random mixing infection formula
  constant <- alpha_r * nc / (bmu^2 * (n - 1))
  
  # daily simulation loop
  for (t in 2:nt) {
    
    state <- x                                    # copy current state
    infected <- which(x == 2)                     # index of infectious people
    exposed <- which(x == 1)                      # index of exposed people
    
    # 1. infectious people transitioning to recovered
    if (length(infected) > 0) {
      recovered <- runif(length(infected)) < delta
      state[infected[recovered]] <- 3
    }
    
    # 2. exposed people transitioning to infected
    if (length(exposed) > 0) {
      inf_next <- runif(length(exposed)) < gamma
      state[exposed[inf_next]] <- 2
    }
    
    infected <- which(x == 2)
    susceptible <- which(x == 0)
    
    # 3. susceptible people may become exposed
    if (length(infected) > 0 && length(susceptible) > 0) {
      
      risk <- rep(FALSE, n)                     # vector to track who becomes exposed
      
      # looping through every infected person
      for (i in infected) {
        
        # household transmission
        # infected and susceptible people in the same household
        household <- which(h == h[i] & state == 0)
        if (length(household) > 0) {
          infections <- runif(length(household)) < alpha_h
          risk[household[infections]] <- TRUE
        }
        
        # regular contacts
        contacts <- alink[[i]]                           # list of i's social network
        if (length(contacts) > 0) {
          S_contacts <- contacts[state[contacts] == 0]   # those who are susceptible
          if (length(S_contacts) > 0) {
            infections <- runif(length(S_contacts)) < alpha_c
            risk[S_contacts[infections]] <- TRUE
          }
        }
        
        # random mixing using formula for the probability of a link
        if (length(susceptible) > 0) {
          random_prob <- constant * beta[i] * beta[susceptible]
          infections <- runif(length(susceptible)) < random_prob
          risk[susceptible[infections]] <- TRUE
        }
        
        # update states with those who are now exposed
        state[risk] <- 1
      }
    }
      
      # update with new states
      x <- state
      
      # record state counts for day t
      S[t] <- sum(x == 0)
      E[t] <- sum(x == 1)
      I[t] <- sum(x == 2)
      R[t] <- sum(x == 3)
    }
    
    # return the daily totals
    list(S=S, E=E, I=I, R=R, t = 1:nt)
}

