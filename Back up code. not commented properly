# building a record of stage directions so that we can remove them from the text
open_bracket <- grep("\\[", a) # locating the positions of all the open brackets
stage_dir <- c()
for (i in open_bracket) {
  stage_dir_index <- grep("\\]", a[(i+1):(i+100)]) # locating the corresponding close brackets
  if (length(stage_dir_index) > 0) {
    close_bracket <- i + stage_dir_index[1]
    stage_dir <- c(stage_dir, i:close_bracket) # creating a vector of the stage directions
  }
}
a.clean <- a[-stage_dir] # removing them from the original text

# removing names and numbers, with exceptions I and A
remove_index <- which(a.clean == toupper(a.clean) & a.clean != "I" & a.clean != "A") 
a.clean <- a.clean[-remove_index]

# remove dashes and underscores
a.clean <- gsub("_-", " ", a.clean)

# creating a function that splits the punctuation
split_punct <- function(punct) {
  y <- gsub(punct, paste(" ", punct, sep = ""), a.clean)
  y <- strsplit(y, split = " ")
  a.clean <- do.call(c,y)
}

punctuation <- list(",","\\.",";","!",":","\\?")
for (x in punctuation) {
  a.clean <- split_punct(x)
}

# Change all words to lowercase
a.clean <- tolower(a.clean)


# counting how frequently each unique word occurs
unique_words <- unique(a.clean)
index_vector <- match(a.clean, unique_words)
freq <- tabulate(index_vector)
rank_freq <- rank(freq, ties.method='min')

# The four most common 'words' in order are: "," "." "the" "and"
b_index <- order(rank_freq, decreasing=TRUE)[1:1000]
b <- unique_words[b_index] # vector of common words

#### PART 6

# creating a matrix to find a sequence of adjacent words of tokens
mlag <- 4    # set mlag to 4
token <- match(a.clean, b) # common word tokens
n <- length(token)
M <- matrix(0, nrow = n-mlag, ncol = mlag+1) # (n-mlag)x(mlag+1) matrix of 0's

# using a for loop to add tokens to the matrix
for(i in 1:(mlag+1)) {
  M[,i] <- token[i:(n-mlag+i-1)]
}

#### Part (7) ####


next_word <- function(key,M,w=rep(1,ncol(M)-1)) {
  #initialization
  sentence <- c()
  match2 <- c()
  next_word_token <- 1
  mc <- 1
  
  
  sentence[length(sentence)+1] <- b[key[mlag]]
  cat(sentence, "is the randomly chosen starting word \n")
  
  while (b[next_word_token] != ".") {
    for (mc in 1:mlag) {
      if (length(match2) > 0) {
        break
      }
      ii <- colSums(!(t(M[,mc:mlag,drop=FALSE])==key[mc:mlag]))
      match <- which(ii == 0 & is.finite(ii))
      if (length(match) > 0) {
        for (s in 1:length(match)) {
          if (is.na(M[match[s],mlag+1]) == FALSE) {
            match2[length(match2)+1] <- match[s]
          }
        }
      }
    }
    next_word_index <- match2[sample(1:length(match2),1)]  ## pick a random matching row
    
    next_word_token <- as.numeric(M[next_word_index, mlag+1])
    
    #create our sentence
    sentence[length(sentence)+1] <- b[next_word_token]
    
    #update our key
    for (m in 1:(mlag-1)) {
      key[m] <- key[m+1]
    }
    key[mlag] <- next_word_token
    
    #reset object
    match2 <- NULL
    
    
  }
  paste(sentence, collapse = " ")
}

#create a random starting key that isn't punctuation
punct_mark = c(",",".","?","!",";",":")
