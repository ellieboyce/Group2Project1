## Create our beta
bmu = 5e-5
bsc = 1e-5
beta <- runif(n)
bmean <- mean(beta)

## get.net function

get.net <- function(beta,h,nc=15){
  alink <- vector(mode = "list", length = n)  ## Initilaize an empty vector
  for(i in 1:n) {
    prob <- (nc*beta[i]*beta)/((bmean^2)*(n-1))  ## Find all probabilities for person i using formula
    u <- runif(n) ## random uniform deviates

    b <- which((u<prob)&(h!=h[i]))
    b <- b[b>i]
    alink[[i]] <- c(alink[[i]],b) ## Assign person i's regular contacts
    
    
    for(x in alink[[i]]) {  ## Recording all contacts twice
      if (x>i){
      alink[[x]] <- c(alink[[x]],i)
      }
    }
  }

  return(alink)
}

alink <- get.net(beta,h)

