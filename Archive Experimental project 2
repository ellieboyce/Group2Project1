#### (3) This damn Nseir function ####

nseir <- function(beta,h,alink,alpha=c(.1,.01,.01),delta=.2,gamma=.4,nc=15, nt = 100,pinf = .005) {
  x <- rep(0,n) ## initialize to susceptible state
  ni <- n*pinf
  x[sample(1:n, round(ni))] <- 2 ## create some infectives
  S <- E <- I <- R <- rep(0,nt) ## set up storage for pop in each state
  S[1] <- n-ni;I[1] <- ni ## initialize
  for (i in 2:nt) { ## loop over days
    
    infect <- x[x==2]
    u <- runif(n) ## uniform random deviates

    x[x==2&u<delta] <- 3 ## I -> R with prob delta
    x[x==1&u<gamma] <- 2 ## E -> I with prob gamma
    
    for (j in infect) { ## S -> E
      x[(h==h[j])&(u<alpha[1])&x==0] <- 1 ## household contacts
      u <- runif(n)
      m <- rep(0,n)
      m[alink[[j]]] <- 1
      x[m&(u<alpha[2])&x==0] <- 1 # # regular mixing
      u <- runif(n)
      prob <- (alpha[3]*nc*beta[j]*beta)/((bmean^2)*(n-1)) 
      x[x==0&u<prob] <- 1 ## Random contacts
    }
    
    S[i] <- sum(x==0); E[i] <- sum(x==1)
    I[i] <- sum(x==2); R[i] <- sum(x==3)
  }
  list(S=S,E=E,I=I,R=R)
} ## nseir

